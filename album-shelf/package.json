{
  "name": "album-shelf",
  "version": "1.0.0",
  "description": "网易云音乐专辑收藏管理工具，支持 MusicBrainz 数据补全",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-rebuild",
    "ncm-cli": "ncm-cli",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "keywords": [
    "music",
    "album",
    "netease",
    "musicbrainz",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.albumshelf.app",
    "productName": "AlbumShelf",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!**/ffprobe-static/bin/win32/ia32{,/**/*}",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "files": [
        "!**/ffprobe-static/bin/darwin{,/**/*}",
        "!**/ffprobe-static/bin/linux{,/**/*}"
      ],
      "extraResources": [
        {
          "from": "build/ncm-configure.bat",
          "to": "ncm-configure.bat"
        },
        {
          "from": "build/ncm-configure.exe",
          "to": "ncm-configure.exe"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "arch": [
        "arm64"
      ],
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "files": [
        "!**/ffprobe-static/bin/win32{,/**/*}",
        "!**/ffprobe-static/bin/linux{,/**/*}"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AlbumShelf"
    }
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@music163/ncm-cli": "0.1.6",
    "better-sqlite3": "^12.8.0",
    "musicbrainz-api": "^1.2.0",
    "vue": "^3.5.32"
  }
}
